[worldserver]

########################################
# mod-action-combat
# Zelda / Elden Ring style action combat. Requires the ActionCombat client addon
# (mod-action-combat/addon/ActionCombat -> Interface/AddOns/ActionCombat).
# Players without the addon keep normal WoW combat (nothing changes for them).
# All times are milliseconds. Stamina uses a 0..Max scale.
########################################

ActionCombat.Enable = 1
ActionCombat.Announce = 1

# ---- Stamina
ActionCombat.Stamina.Max = 100
ActionCombat.Stamina.RegenPerSec = 35
# pause after spending before regen starts
ActionCombat.Stamina.RegenDelayMs = 900
# regen speed while holding guard (% of normal)
ActionCombat.Stamina.GuardRegenPct = 40

# ---- Dodge roll (8 directions from WASD; no movement = backstep)
ActionCombat.Dodge.Cost = 25
ActionCombat.Dodge.CooldownMs = 450
# invulnerable window
ActionCombat.Dodge.IFramesMs = 400
# horizontal roll speed (distance ~ speed * airtime)
ActionCombat.Dodge.SpeedXY = 16
# small hop; lower = flatter roll
ActionCombat.Dodge.SpeedZ = 3
ActionCombat.Dodge.BackstepSpeedXY = 10
ActionCombat.Dodge.BackstepIFramesMs = 250

# How a directional dodge moves you (melee and ranged; casters Blink instead):
#   1 = dash: a fast run along the ground in that direction (follows terrain, stops at walls)
#   0 = hop: the old knockback hop (jump animation)
# Backstep (dodge while standing still) is always the short backward hop.
ActionCombat.Dodge.Style = 1
ActionCombat.Dodge.DashDistance = 7
# yards per second (7 yd at 26 = ~0.27 s, inside the i-frame window)
ActionCombat.Dodge.DashSpeed = 26
# WoW 3.3.5 has no roll animation. If you add one to the character models with a client patch,
# put it in an unused emote slot and enter that emote id here, e.g. 402 = Custom Spell 01
# (the "CUSTOM_SPELL_01..10" emotes are 402-411). 0 = off. Every player needs the patch.
ActionCombat.Dodge.CustomAnimEmote = 0

# ---- Light attack (3-hit combo, cone cleave)
ActionCombat.Light.Cost = 12
ActionCombat.Light.CooldownMs = 550
ActionCombat.Light.Range = 5
ActionCombat.Light.ArcDegrees = 100
# 3rd hit is a wide sweep
ActionCombat.Light.FinisherArcDegrees = 200
ActionCombat.Light.Poise = 12
ActionCombat.Light.ComboWindowMs = 1100
# multiplier on normal weapon damage
ActionCombat.Light.Combo1Mult = 1.0
ActionCombat.Light.Combo2Mult = 1.15
ActionCombat.Light.Combo3Mult = 1.5

# ---- Heavy attack (hold to charge, release to swing)
ActionCombat.Heavy.Cost = 30
# releasing earlier cancels
ActionCombat.Heavy.MinChargeMs = 350
ActionCombat.Heavy.MaxChargeMs = 1500
ActionCombat.Heavy.CooldownMs = 900
ActionCombat.Heavy.Range = 6
ActionCombat.Heavy.ArcDegrees = 140
ActionCombat.Heavy.MinMult = 1.6
# fully charged
ActionCombat.Heavy.MaxMult = 2.8
# doubles at full charge
ActionCombat.Heavy.Poise = 40

ActionCombat.Attack.MaxTargets = 5

# ---- Dual wield (two swords, two daggers, sword + dagger, ...)
# Light combo becomes: right hand -> LEFT hand -> double strike (right, then left a moment later).
# Heavy becomes a cross slash: right blade, then the left blade follows.
# Hits play the client's own off-hand animations (off-hand slash, dagger stab).
ActionCombat.DualWield.Enable = 1
# WoW already gives off-hand hits 50% damage; this multiplies off-hand action swings on top
ActionCombat.DualWield.OffhandMult = 1.5
# delay before the left-hand half of a double strike / cross slash
ActionCombat.DualWield.FollowUpMs = 200
# light attack cooldown multiplier while dual wielding (faster combos)
ActionCombat.DualWield.CooldownMult = 0.85

# Damage % of normal auto-attack swings for players using the addon.
# 100 = untouched, 0 = auto-attack does nothing (pure action combat).
ActionCombat.AutoAttack.DamagePct = 30

# ---- Guard & perfect parry
ActionCombat.Guard.DamageReductionPct = 70
# stamina lost per 1% of max HP blocked
ActionCombat.Guard.StaminaPerHpPct = 2
ActionCombat.Guard.MinStaminaPerHit = 8
# 1 = guard also reduces non-melee spells
ActionCombat.Guard.BlocksSpells = 0
# press guard this close to a hit = perfect parry
ActionCombat.Parry.WindowMs = 220
# poise damage a parry deals to the attacker
ActionCombat.Parry.Poise = 100

# ---- Stagger / poise / riposte
# Aura applied on stagger and guard break. 56 = generic 3s "Stun". Make your own short stun
# in spell_dbc for a snappier ~1.5s stagger.
ActionCombat.Stagger.SpellId = 56
# 0 = can't be staggered
ActionCombat.Poise.Normal = 40
ActionCombat.Poise.Elite = 120
ActionCombat.Poise.Boss = 0
# poise refills if not hit for this long
ActionCombat.Poise.ResetAfterMs = 4000
# time after a stagger to land the critical hit
ActionCombat.Riposte.WindowMs = 3000
ActionCombat.Riposte.Mult = 2.5


########################################
# ---- Magic style (mana classes)
# Casters fight with spells instead of weapon swings, and every action costs MANA
# (as % of base mana, same as Blizzard's spell costs) instead of stamina:
#   Light = aimed bolt (3-hit combo)   Heavy = charged volley (a bolt per enemy in a cone)
#   Dodge = Blink with i-frames        Guard = mana ward (tap timing = spell deflect)
# Druids in Cat/Bear form and Shamans in Ghost Wolf switch to melee style automatically.
# Players can force a style with /acm magic | /acm melee | /acm auto (any class with mana).
########################################

ActionCombat.Magic.Enable = 1

# Class ids that default to magic style: 2 Paladin, 5 Priest, 7 Shaman, 8 Mage, 9 Warlock, 11 Druid
ActionCombat.Magic.Classes = "5,7,8,9,11"

# ---- Elements: casters switch between elements (Switch element key, or /acm element <name>).
# Each element fires a real spell, so its school (resistances / immunities), projectile, impact
# and built-in extras come with it: Fireball burns, Frostbolt slows. On top of that each element
# has its own numbers. Bolt damage, mana cost and cooldown are multiplied by the element's values.
#   Fire       Fireball        hits harder, costs more, burns
#   Frost      Frostbolt       less damage, slows, 1.6x poise (staggers enemies fast)
#   Arcane     Arcane Barrage  weaker but 30% faster rapid fire, cheaper
#   Shadow     Shadow Bolt     heals you for 20% of the damage it deals
#   Holy       Smite           1.5x damage to demons and undead
#   Lightning  Lightning Bolt  chains to 2 more nearby enemies (50%, then 25%)
#   Nature     Wrath           cheap, heals you for 10% of the damage it deals
#   Lunar      Starfire        slow and heavy: 1.3x damage, 1.4x cooldown, more poise
#
# Which elements each class can use (first one is the default):
ActionCombat.Magic.Elements.Mage = "Fire,Frost,Arcane"
ActionCombat.Magic.Elements.Warlock = "Shadow,Fire"
ActionCombat.Magic.Elements.Priest = "Holy,Shadow"
ActionCombat.Magic.Elements.Shaman = "Lightning,Fire,Frost"
ActionCombat.Magic.Elements.Druid = "Nature,Lunar"
ActionCombat.Magic.Elements.Paladin = "Holy"
# 1 = an element is only available once the player has learned (any rank of) its spell
ActionCombat.Magic.Elements.RequireSpellKnown = 0
ActionCombat.Magic.Elements.SwitchCooldownMs = 600
#
# Every element can be tuned. Shown for Fire; same keys for the others:
#   .Spell .DamageMult .CostMult .CooldownMult .PoiseMult .LeechPct
#   .ChainTargets .ChainRange .ChainFalloff .VsDemonUndeadMult
ActionCombat.Magic.Element.Fire.Spell = 133
ActionCombat.Magic.Element.Fire.DamageMult = 1.15
ActionCombat.Magic.Element.Fire.CostMult = 1.2
ActionCombat.Magic.Element.Frost.Spell = 116
ActionCombat.Magic.Element.Frost.PoiseMult = 1.6
ActionCombat.Magic.Element.Arcane.Spell = 44425
ActionCombat.Magic.Element.Arcane.CooldownMult = 0.7
ActionCombat.Magic.Element.Shadow.Spell = 686
ActionCombat.Magic.Element.Shadow.LeechPct = 20
ActionCombat.Magic.Element.Holy.Spell = 585
ActionCombat.Magic.Element.Holy.VsDemonUndeadMult = 1.5
ActionCombat.Magic.Element.Lightning.Spell = 403
ActionCombat.Magic.Element.Lightning.ChainTargets = 2
ActionCombat.Magic.Element.Lightning.ChainRange = 8
ActionCombat.Magic.Element.Lightning.ChainFalloff = 0.5
ActionCombat.Magic.Element.Nature.Spell = 5176
ActionCombat.Magic.Element.Nature.LeechPct = 10
ActionCombat.Magic.Element.Lunar.Spell = 2912
ActionCombat.Magic.Element.Lunar.DamageMult = 1.3

# Fallback only: the single bolt for a class whose element list above is empty.
# Spell used as each class's projectile (visual, school, travel time). Damage is set by the module.
ActionCombat.Magic.BoltSpell.Paladin = 879
ActionCombat.Magic.BoltSpell.Priest = 585
ActionCombat.Magic.BoltSpell.Shaman = 403
ActionCombat.Magic.BoltSpell.Mage = 133
ActionCombat.Magic.BoltSpell.Warlock = 686
ActionCombat.Magic.BoltSpell.Druid = 5176

# Bonus mana regen (% of base mana per second) after not spending for RegenDelayMs.
# Slowed by Stamina.GuardRegenPct while warding. 0 = off.
ActionCombat.Magic.RegenPctPerSec = 2
ActionCombat.Magic.RegenDelayMs = 1500

# ---- Bolt (light)
ActionCombat.Magic.Bolt.CostPct = 2.5
ActionCombat.Magic.Bolt.CooldownMs = 450
ActionCombat.Magic.Bolt.Range = 30
# free-aim cone when you have no target (or it's behind you)
ActionCombat.Magic.Bolt.AimArcDegrees = 40
# your selected enemy is kept as long as it's within this cone in front of you
ActionCombat.Magic.Bolt.SoftLockArcDegrees = 120
# damage = BaseDamage + DamagePerLevel * level + SpellPower * SpellPowerCoef
ActionCombat.Magic.Bolt.BaseDamage = 25
ActionCombat.Magic.Bolt.DamagePerLevel = 8
ActionCombat.Magic.Bolt.SpellPowerCoef = 0.55
ActionCombat.Magic.Bolt.Poise = 10
ActionCombat.Magic.Bolt.Combo1Mult = 1.0
ActionCombat.Magic.Bolt.Combo2Mult = 1.1
ActionCombat.Magic.Bolt.Combo3Mult = 1.4

# ---- Volley (heavy; uses Heavy.MinChargeMs / Heavy.MaxChargeMs and Attack.MaxTargets)
ActionCombat.Magic.Volley.CostPct = 9
ActionCombat.Magic.Volley.CooldownMs = 1000
ActionCombat.Magic.Volley.Range = 25
ActionCombat.Magic.Volley.ArcDegrees = 90
ActionCombat.Magic.Volley.MinMult = 1.3
ActionCombat.Magic.Volley.MaxMult = 2.4
ActionCombat.Magic.Volley.Poise = 35

# ---- Blink (dodge; uses Dodge.CooldownMs, Dodge.IFramesMs, Dodge.BackstepIFramesMs)
ActionCombat.Magic.Blink.CostPct = 4
ActionCombat.Magic.Blink.Distance = 8
ActionCombat.Magic.Blink.BackstepDistance = 5
# optional extra cosmetic spell cast on yourself when blinking (0 = none)
ActionCombat.Magic.Blink.VisualSpellId = 0

# Blink effects per class: a flash left at the start point, a flash where you land, and an
# optional extra sound (SoundEntries id, heard by nearby players; 0 = none). The flashes are
# visual-only spells NPCs use in 3.3.5 and play their own sound. The server only plays spells
# with no real effect and no script attached; anything else is refused and logged.
#   51347 Teleport Visual Only      61456 Evil Teleport Visual Only
#   35426 Arcane Explosion Visual   70785 Holy Bomb Visual
#   64785 Random Lightning Visual   34770 Plant Spawn Effect
ActionCombat.Magic.Blink.Mage.DepartSpell = 51347
ActionCombat.Magic.Blink.Mage.ArriveSpell = 35426
ActionCombat.Magic.Blink.Mage.SoundId = 0
ActionCombat.Magic.Blink.Warlock.DepartSpell = 61456
ActionCombat.Magic.Blink.Warlock.ArriveSpell = 61456
ActionCombat.Magic.Blink.Warlock.SoundId = 0
ActionCombat.Magic.Blink.Priest.DepartSpell = 51347
ActionCombat.Magic.Blink.Priest.ArriveSpell = 70785
ActionCombat.Magic.Blink.Priest.SoundId = 0
ActionCombat.Magic.Blink.Paladin.DepartSpell = 51347
ActionCombat.Magic.Blink.Paladin.ArriveSpell = 70785
ActionCombat.Magic.Blink.Paladin.SoundId = 0
ActionCombat.Magic.Blink.Shaman.DepartSpell = 51347
ActionCombat.Magic.Blink.Shaman.ArriveSpell = 64785
ActionCombat.Magic.Blink.Shaman.SoundId = 0
ActionCombat.Magic.Blink.Druid.DepartSpell = 51347
ActionCombat.Magic.Blink.Druid.ArriveSpell = 34770
ActionCombat.Magic.Blink.Druid.SoundId = 0
# Invisible, unselectable creature summoned for 3 seconds to hold each flash in place
# (12999 = World Invisible Trigger). 0 = play the flashes on the caster instead.
ActionCombat.Magic.Blink.MarkerCreature = 12999

# ---- Ward (guard; perfect timing uses Parry.WindowMs / Parry.Poise and also deflects spells)
ActionCombat.Magic.Ward.DamageReductionPct = 75
# mana paid per point of damage prevented; not enough mana = ward shatters (stagger)
ActionCombat.Magic.Ward.ManaPerDamage = 1.5
ActionCombat.Magic.Ward.BlocksSpells = 1

# Magic shield bubble shown around the caster while warding (0 = none). These are the cosmetic
# shield auras NPCs use in 3.3.5. The server only applies spells that are purely visual
# (dummy aura); anything with a real effect is refused and logged.
#   45775 = Cosmetic - Divine Shield Blue
#   46934 = Cosmetic - Arcane Force Shield
#   53143 = Cosmetic - Arcane Force Shield Dark State
ActionCombat.Magic.WardVisual.Paladin = 45775
ActionCombat.Magic.WardVisual.Priest = 45775
ActionCombat.Magic.WardVisual.Shaman = 46934
ActionCombat.Magic.WardVisual.Mage = 46934
ActionCombat.Magic.WardVisual.Warlock = 53143
ActionCombat.Magic.WardVisual.Druid = 46934


########################################
# ---- Shooting (bows, guns, crossbows)
# Shooting has its OWN two keys (Esc > Key Bindings > Action Combat), usable in any style
# whenever a bow, gun or crossbow is equipped, so Light/Heavy stay melee (or magic):
#   Quick shot  = tap: aimed shot (3-shot rhythm)
#   Aimed shot  = hold to draw, release to fire; a full draw PIERCES every enemy on the line
# Shots use the real ranged weapon damage, ammo, projectile, crits and procs, and cost stamina.
# The character draws the ranged weapon to shoot and the melee weapon to swing.
#
# Optional "ranged style": also puts shooting on Light/Heavy (players: /acm ranged, or list
# classes below). In that style an enemy in your face makes Light/Heavy swing the melee weapon.
########################################

ActionCombat.Ranged.Enable = 1

# Class ids that default to the ranged STYLE (shoot on Light/Heavy) while holding a ranged weapon.
# Empty = nobody by default; everyone shoots with the dedicated shot keys. "3" = Hunters.
ActionCombat.Ranged.Classes = ""
ActionCombat.Ranged.AllowThrown = 0

# Single-fire ranged spell used for every shot. 6660 is the "Shoot" NPC archers and riflemen use.
# Do NOT use auto-repeat spells (75 Auto Shot, the player's own Shoot): they start the auto-shot loop.
ActionCombat.Ranged.ShootSpellId = 6660

# ---- Quick shot
ActionCombat.Ranged.Shot.Cost = 10
ActionCombat.Ranged.Shot.CooldownMs = 600
ActionCombat.Ranged.Shot.Range = 35
ActionCombat.Ranged.Shot.AimArcDegrees = 30
ActionCombat.Ranged.Shot.SoftLockArcDegrees = 120
ActionCombat.Ranged.Shot.Poise = 8
# multipliers on ranged weapon damage
ActionCombat.Ranged.Shot.Combo1Mult = 1.0
ActionCombat.Ranged.Shot.Combo2Mult = 1.1
ActionCombat.Ranged.Shot.Combo3Mult = 1.3

# ---- Aimed / power shot (uses Heavy.MinChargeMs / Heavy.MaxChargeMs as the draw time)
ActionCombat.Ranged.PowerShot.Cost = 28
ActionCombat.Ranged.PowerShot.CooldownMs = 1000
ActionCombat.Ranged.PowerShot.Range = 40
ActionCombat.Ranged.PowerShot.MinMult = 1.8
ActionCombat.Ranged.PowerShot.MaxMult = 3.2
ActionCombat.Ranged.PowerShot.Poise = 35
# full draw: half-width (yards) of the piercing line and how many enemies it can go through
ActionCombat.Ranged.PowerShot.PierceWidth = 2
ActionCombat.Ranged.PowerShot.PierceMaxTargets = 4

# ---- Enemies in your face
# 0 = can't shoot inside the shot's minimum range (roll back to make space)
# 1 = keep shooting: point-blank shots at close enemies
# 2 = (default) the shot keys shoot point-blank; in the ranged style, Light/Heavy instead
#     swing the melee weapon (if one is equipped) while an enemy is within
#     CloseRange (weapon is drawn on the model), then switch back to shooting when they're
#     further away. Without a melee weapon this behaves like 1.
# Players can choose their own with /acm close swap | shoot | off | default
ActionCombat.Ranged.CloseRangeMode = 2
ActionCombat.Ranged.CloseRange = 6
# damage of a point-blank shot compared to a normal shot
ActionCombat.Ranged.PointBlankMult = 0.85


########################################
# ---- Sprint (hold the Sprint key while moving)
# Multiplies your current run speed (buffs and slows still count). Drains stamina while you
# actually move; stamina doesn't regenerate while sprinting. Magic style pays mana instead.
# Stops automatically when stamina runs out, when mounted, rooted, stunned or guarding.
########################################

ActionCombat.Sprint.Enable = 1
ActionCombat.Sprint.SpeedMult = 1.45
ActionCombat.Sprint.StaminaPerSec = 12
ActionCombat.Sprint.MinStaminaToStart = 10
# % of base mana per second while sprinting in magic style
ActionCombat.Sprint.MagicManaPctPerSec = 1
ActionCombat.Sprint.AllowInCombat = 1


########################################
# ---- Animations
# WoW 3.3.5 can only play animations the character models already have, so the module uses
# the best existing ones: weapon "ready" pose while guarding (1H / 2H / polearm / unarmed /
# spellcaster), shield-block or weapon-parry when a guarded hit lands, a parry plus attacker
# recoil on a perfect parry, and a dodge flinch when i-frames avoid a hit. The roll itself
# uses the jump animation from the knockback.
########################################

ActionCombat.Anim.Enable = 1
# hold a ready pose while guarding (cleared when you move, restored when you stop)
ActionCombat.Anim.GuardStance = 1
# Optional cosmetic spells (cast on yourself, triggered). 0 = none. Use a purely visual spell,
# e.g. a custom one from spell_dbc, so it doesn't add any effect of its own.
ActionCombat.Anim.DodgeVisualSpellId = 0
ActionCombat.Anim.ParryVisualSpellId = 0

# Magic Heavy (charged volley): while you hold the key, your character plays the current
# element's real spell wind-up (Fireball fire hands, Frostbolt frost hands, Shadow Bolt shadow,
# Smite holy light, Lightning Bolt sparks...) with its animation, sound and a cast bar that fills
# over Heavy.MaxChargeMs. Nothing is actually cast until you release. Other players see it too.
ActionCombat.Anim.MagicChargeCast = 1


########################################
# ---- Interact key (loot / talk / use without letting go of the camera)
# Picks the best thing in front of the player: a corpse they may loot, a friendly NPC
# (gossip, quests, vendor, trainer, flight master, bank, auction, stable) or a usable object
# (unlocked chests, quest objects, mailboxes, doors, portals...). It goes through the same
# server handlers as a real mouse click, so range, faction, quest and loot rules are unchanged.
# Herbs, ore and locked chests still need a normal click (they need their gathering/opening spell).
########################################

ActionCombat.Interact.Enable = 1
ActionCombat.Interact.Range = 6
ActionCombat.Interact.ArcDegrees = 120
